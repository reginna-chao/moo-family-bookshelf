{
  "name": "moo-family-bookshelf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n ext,worker,pwa -c blue,green,magenta \"pnpm --filter moo-family-bookshelf-extension dev\" \"pnpm --filter moo-family-bookshelf-worker dev\" \"pnpm --filter moo-family-bookshelf-pwa dev\"",
    "dev:extension": "pnpm --filter moo-family-bookshelf-extension dev",
    "dev:worker": "pnpm --filter moo-family-bookshelf-worker dev",
    "dev:pwa": "pnpm --filter moo-family-bookshelf-pwa dev",
    "build": "pnpm --filter moo-family-bookshelf-extension build && pnpm --filter moo-family-bookshelf-worker build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter moo-family-bookshelf-extension test:coverage",
    "test:e2e": "pnpm run test:e2e:extension && pnpm run test:e2e:pwa",
    "test:e2e:extension": "pnpm --filter moo-family-bookshelf-extension build:e2e && pnpm --filter moo-family-bookshelf-extension test:e2e",
    "test:e2e:pwa": "pnpm --filter moo-family-bookshelf-pwa test:e2e",
    "e2e:verify:selectors": "pnpm --filter moo-family-bookshelf-extension e2e:verify:selectors",
    "e2e:verify:selectors:update": "pnpm --filter moo-family-bookshelf-extension e2e:verify:selectors:update",
    "clean:kv": "rimraf worker/.wrangler/state",
    "prepare": "husky"
  },
  "lint-staged": {
    "extension/src/**/*.{ts,tsx}": ["pnpm --filter moo-family-bookshelf-extension exec eslint --fix"],
    "worker/src/**/*.{ts,tsx}": ["pnpm --filter moo-family-bookshelf-worker exec eslint --fix"],
    "pwa/src/**/*.{ts,tsx}": ["pnpm --filter moo-family-bookshelf-pwa exec eslint --fix"]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rimraf": "^6.1.3"
  }
}
