{
  "name": "moo-family-bookshelf-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "dev:remote": "wrangler dev --ip 0.0.0.0 --remote --config wrangler.local.toml",
    "build": "wrangler deploy --dry-run --outdir=dist --env production",
    "build:dev": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy --env production",
    "deploy:dev": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20241230.0",
    "@eslint/js": "9.17.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
