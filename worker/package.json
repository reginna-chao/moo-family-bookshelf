{
  "name": "moo-family-bookshelf-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "wrangler deploy",
    "deploy:local": "bash -c 'source .env && sed \"s/placeholder-kv-id/$KV_NAMESPACE_ID/;s/placeholder-preview-id/$KV_PREVIEW_NAMESPACE_ID/\" wrangler.toml > wrangler.local.toml && wrangler deploy -c wrangler.local.toml && rm wrangler.local.toml'"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.34",
    "@cloudflare/workers-types": "^4.20241230.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
