# 複製此檔案為 .env，依本機環境修改。
# .env        → pnpm dev 預設（打本機 wrangler）
# .env.remote → pnpm dev:remote 載入（打已部署 dev worker，由 git 追蹤）

# ===== Extension =====
VITE_EXTENSION_API_ENDPOINT=http://localhost:8787
VITE_EXTENSION_PWA_URL=http://localhost:5173

# ===== PWA =====
# 絕對 URL 指向本機 wrangler；localhost HTTP 已通過 Worker CORS 白名單
VITE_PWA_API_ENDPOINT=http://localhost:8787
