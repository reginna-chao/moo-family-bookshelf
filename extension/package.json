{
  "name": "moo-family-bookshelf-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:main": "vite build --watch --mode development",
    "dev:content": "vite build --watch --mode development --config vite.config.content.ts",
    "dev:content-modules": "vite build --watch --mode development --config vite.config.content-modules.ts",
    "dev:fiber-bridge": "vite build --watch --mode development --config vite.config.fiber-bridge.ts",
    "dev": "rimraf dist && concurrently pnpm:dev:*",
    "sync-version": "tsx scripts/sync-version.ts",
    "build": "tsx scripts/sync-version.ts && tsc --noEmit && vite build && vite build --config vite.config.content.ts && vite build --config vite.config.content-modules.ts && vite build --config vite.config.fiber-bridge.ts && tsx scripts/verify-build.ts",
    "build:dev": "tsx scripts/sync-version.ts && tsc --noEmit && vite build --mode dev && vite build --mode dev --config vite.config.content.ts && vite build --mode dev --config vite.config.content-modules.ts && vite build --mode dev --config vite.config.fiber-bridge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "E2E_HEADED=1 playwright test",
    "build:e2e": "tsx scripts/build-e2e.ts",
    "e2e:verify:selectors": "tsx scripts/verify-selectors.ts",
    "e2e:verify:selectors:update": "tsx scripts/verify-selectors.ts --update-mock"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
