# Prettier v3 resolves ignore files from the CURRENT WORKING DIRECTORY only —
# it never searches upward. Running `prettier --write .` (or `--check .`) with
# cwd = `extension/` therefore ignores the repo-root `.prettierignore` entirely.
# This file exists so such a run behaves like a repo-root run.
# Keep it in sync with the root `.prettierignore` (extension-relative subset).

# Generated files — rewritten verbatim by the scripts that own them, so
# reformatting them here would just churn on the next build.
